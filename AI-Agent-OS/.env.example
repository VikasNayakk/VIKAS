"""
Environment variables template
Copy this to .env and fill in your values

Usage in Python:
from dotenv import load_dotenv
import os

load_dotenv()
api_key = os.getenv('OPENAI_API_KEY')
"""

# OpenAI API
OPENAI_API_KEY=sk-your-api-key-here

# Anthropic Claude API
# Get full key from: https://console.anthropic.com/settings/keys
# (only shown once at creation; the "partial_key_hint" in admin API is NOT usable)
ANTHROPIC_API_KEY=sk-ant-api03-your-full-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY_ID=apikey_01Rj2N8SVvo6BePZj99NhmiT
ANTHROPIC_ADMIN_API_KEY=sk-ant-admin-your-admin-key-here

# Local LLM (if using ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Microsoft Teams (if integrating)
TEAMS_API_KEY=your-teams-api-key

# Slack (if integrating)
SLACK_API_KEY=your-slack-api-key

# Browser settings
BROWSER_DRIVER=chrome
BROWSER_HEADLESS=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=./data/logs/system.log

# System
DEBUG=false
TIMEOUT=30
